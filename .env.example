# Copy to .env (cp .env.example .env). Never commit .env.

# Backend (FastAPI + Celery). docker compose overrides the two URLs to point at its containers.
DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5432/recall_radar
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Optional: raises openFDA's daily request limit. Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
